<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/serialBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/serialTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/serialPhotosButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/round_button_background"
            android:contentDescription="@string/serial_photos_title"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gallery" />

        <TextView
            android:id="@+id/serialCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_background"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Camera: aim at the label and take a photo -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/serialPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Aiming frame -->
        <View
            android:layout_width="300dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_marginBottom="40dp"
            android:background="@drawable/scan_frame" />

        <ImageButton
            android:id="@+id/torchButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/round_button_background"
            android:contentDescription="@string/serial_torch"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_torch" />

        <!-- Last result -->
        <TextView
            android:id="@+id/serialLast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/chip_background"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Shutter row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/pickPhotoButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/round_button_background"
                android:contentDescription="@string/serial_from_gallery"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gallery" />

            <ImageButton
                android:id="@+id/captureSerialButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_button"
                android:contentDescription="@string/serial_capture" />
        </FrameLayout>

        <!-- Reading the photo -->
        <LinearLayout
            android:id="@+id/readingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/serial_reading"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/candidateHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:text="@string/serial_hint_photo"
        android:textColor="#AAAAAA"
        android:textSize="13sp" />

    <!-- Scanned list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/serialItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/addManualButton"
            style="@style/SerialAction"
            android:layout_marginEnd="8dp"
            android:text="@string/serial_type" />

        <Button
            android:id="@+id/copyAllButton"
            style="@style/SerialAction"
            android:layout_marginEnd="8dp"
            android:text="@string/serial_copy_all" />

        <Button
            android:id="@+id/shareListButton"
            style="@style/SerialAction"
            android:background="@drawable/share_button_background"
            android:text="@string/share" />
    </LinearLayout>
</LinearLayout>
