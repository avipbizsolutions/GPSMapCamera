<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Rule-of-thirds grid (touches pass through to the preview) -->
    <com.example.gpsmapcamera.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Grid on/off -->
    <ImageButton
        android:id="@+id/gridButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/round_button_background"
        android:contentDescription="@string/grid_toggle"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_grid" />

    <!-- Live compass -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="84dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.example.gpsmapcamera.CompassView
            android:id="@+id/compassView"
            android:layout_width="68dp"
            android:layout_height="68dp" />

        <TextView
            android:id="@+id/headingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/chip_background"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tap-to-focus ring (positioned in code) -->
    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/focus_ring"
        android:visibility="invisible" />

    <!-- Zoom level shown while pinching -->
    <TextView
        android:id="@+id/zoomLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/chip_background"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- HD / SD quality switch -->
    <TextView
        android:id="@+id/qualityChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/chip_background"
        android:contentDescription="@string/quality_toggle"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="@string/quality_hd"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Recording timer -->
    <TextView
        android:id="@+id/recTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@drawable/rec_background"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Shown while the GPS stamp is burned into a video -->
    <LinearLayout
        android:id="@+id/processingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/info_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/processingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/info_background"
            android:padding="12dp"
            android:text="@string/waiting_gps"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="28dp">

            <!-- Quick zoom buttons (pinch on the preview for any level) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/zoom_bar_background"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/zoom05"
                    style="@style/ZoomChip"
                    android:text="@string/zoom_05"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/zoom1"
                    style="@style/ZoomChip"
                    android:text="@string/zoom_1" />

                <TextView
                    android:id="@+id/zoom2"
                    style="@style/ZoomChip"
                    android:text="@string/zoom_2" />

                <TextView
                    android:id="@+id/zoom5"
                    style="@style/ZoomChip"
                    android:text="@string/zoom_5" />
            </LinearLayout>

            <!-- Photo / Video switch -->
            <LinearLayout
                android:id="@+id/modeBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/photoTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="6dp"
                    android:text="@string/mode_photo"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/videoTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="6dp"
                    android:text="@string/mode_video"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:id="@+id/thumbnail"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/thumb_background"
                    android:contentDescription="@string/open_gallery"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_gallery" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/shutterButton"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/shutter_button"
                    android:contentDescription="@string/take_photo" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/shareButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/share"
                    android:enabled="false"
                    android:src="@android:drawable/ic_menu_share" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
