<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_subtitle"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tools, two per row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/toolCamera"
                style="@style/ToolCard"
                android:layout_marginEnd="6dp">

                <ImageView
                    style="@style/ToolIcon"
                    android:background="@drawable/tool_icon_bg_camera"
                    android:src="@drawable/ic_tool_camera" />

                <TextView
                    style="@style/ToolTitle"
                    android:text="@string/tool_camera" />

                <TextView
                    style="@style/ToolSubtitle"
                    android:text="@string/tool_camera_sub" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolTilt"
                style="@style/ToolCard"
                android:layout_marginStart="6dp">

                <ImageView
                    style="@style/ToolIcon"
                    android:background="@drawable/tool_icon_bg_tilt"
                    android:src="@drawable/ic_tool_tilt" />

                <TextView
                    style="@style/ToolTitle"
                    android:text="@string/tool_tilt" />

                <TextView
                    style="@style/ToolSubtitle"
                    android:text="@string/tool_tilt_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/toolDocs"
                style="@style/ToolCard"
                android:layout_marginEnd="6dp">

                <ImageView
                    style="@style/ToolIcon"
                    android:background="@drawable/tool_icon_bg_doc"
                    android:src="@drawable/ic_tool_document" />

                <TextView
                    style="@style/ToolTitle"
                    android:text="@string/tool_docs" />

                <TextView
                    style="@style/ToolSubtitle"
                    android:text="@string/tool_docs_sub" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolSerials"
                style="@style/ToolCard"
                android:layout_marginStart="6dp">

                <ImageView
                    style="@style/ToolIcon"
                    android:background="@drawable/tool_icon_bg_barcode"
                    android:src="@drawable/ic_tool_barcode" />

                <TextView
                    style="@style/ToolTitle"
                    android:text="@string/tool_serials" />

                <TextView
                    style="@style/ToolSubtitle"
                    android:text="@string/tool_serials_sub" />
            </LinearLayout>
        </LinearLayout>

        <!-- My photos & videos, full width -->
        <LinearLayout
            android:id="@+id/toolPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tool_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                style="@style/ToolIcon"
                android:background="@drawable/tool_icon_bg_photos"
                android:src="@drawable/ic_gallery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/ToolTitle"
                    android:layout_marginTop="0dp"
                    android:text="@string/tool_photos" />

                <TextView
                    style="@style/ToolSubtitle"
                    android:text="@string/tool_photos_sub" />
            </LinearLayout>
        </LinearLayout>

        <!-- Solar enquiry -->
        <LinearLayout
            android:id="@+id/callCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/call_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_call_title"
                    android:textColor="#08295F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/company_tagline"
                    android:textColor="#CC08295F"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_call_numbers"
                    android:textColor="#08295F"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/tool_icon_bg_camera"
                android:backgroundTint="#08295F"
                android:contentDescription="@string/home_call_title"
                android:padding="11dp"
                android:src="@drawable/ic_phone"
                android:tint="#FFD54F" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
