<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:padding="2dp">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#222222"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/playBadge"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:contentDescription="@string/mode_video"
        android:src="@android:drawable/ic_media_play"
        android:visibility="gone" />

    <!-- Green border on selected items -->
    <View
        android:id="@+id/selectedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selected_overlay"
        android:visibility="gone" />

    <!-- Small select circle, top-right (padding gives a bigger touch area) -->
    <ImageView
        android:id="@+id/selectBox"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/select_item"
        android:padding="8dp"
        android:src="@drawable/ic_select_off" />
</FrameLayout>
